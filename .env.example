# Central Database Configuration
CHRONOS_DB_PATH=database/chronos.db

# Central Server Network Binding
PORT=8000
HOST=0.0.0.0

# Frontend Proxy Target (for React Vite)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Gemini AI Assistant API Key (Round 2 investigation assistant)
# GEMINI_API_KEY=your_gemini_api_key_here
