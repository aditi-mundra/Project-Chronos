# ==============================================================================
# PROJECT CHRONOS — ENVIRONMENT CONFIGURATION
# Copy to .env to override defaults
# ==============================================================================

# Central Database Configuration
CHRONOS_DB_PATH=database/chronos.db

# Central Server Network Binding
PORT=8000
HOST=0.0.0.0

# Frontend Proxy Target (for React Vite)
VITE_BACKEND_URL=http://127.0.0.1:8000

# ==============================================================================
# GROQ AI ANALYST CONFIGURATION (ROUND 2 TERMINAL INVESTIGATION)
# ==============================================================================
# Multi-Key Pool for 10 Teams (auto-rotates and fails over across keys)
GROQ_API_KEYS=gsk_key1_here,gsk_key2_here,gsk_key3_here
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# GOOGLE SPREADSHEET API CONFIGURATION (ROUND 2 AUTHENTICATION PASSWORDS)
# ==============================================================================
# Method 1: Google Cloud Service Account (Official Google Sheets API via gspread)
# Share your Google Spreadsheet with your service account's client_email (Viewer/Editor access)
GOOGLE_SHEET_ID=your_google_sheet_id_or_url_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# Or raw JSON string / base64 string:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional tab/sheet name:
GOOGLE_SHEET_TAB_NAME=Sheet1

# Method 2: Google Apps Script Web App (Webhook alternative, zero GCP IAM setup)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# Emergency Admin Override Password (Fallback if Google Sheets is unreachable)
CHRONOS_ADMIN_PASSWORD=Chronos@123

